generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id String @id
  roles Role[]

  @@map("account")
}

model Role {
  id         String   @id
  artifactId String
  portfolioId String
  accountId  String
  role       String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("role")
}

model Domain {
  id         String   @id
  artifactId String
  domain     String
  isPrimary  Boolean
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@map("domain")
}

model Artifact {
  id             String                 @id
  name           String                 @default("")
  url            String?
  tier           String                 @default("free")
  logoUrl        String?
  description    String?
  socialProfiles Json?
  contactEmail   Json?
  contactPhone   Json?
  modules        Json?
  icons          Json?
  domains        Json?
  createdAt      DateTime?
  updatedAt      DateTime?
  themeEntry     Theme?
  roles          Role[]
  domainEntries  Domain[]
  ownerAccountId String?
  status         String?
  type           String?
  pages          Page[]
  paths          PagePath[]
  sections       Section[]
  datalists      Datalist[]
  sources        DataSource[]
  environments   EnvironmentVariable[]
  redirects      Redirect[]
  codeFiles      CodeFile[]
  allocations    Allocation[]
  structures     SiteStructure[]
  deployments    Deployment[]
  appBaseBackups AppBaseBackup[]

  @@index([ownerAccountId])
  @@map("artifact")
}

model Theme {
  id           String  @id
  hideSitename Boolean @default(false)
  hideLogo     Boolean @default(false)
  theme        Json?
  createdAt    DateTime?
  updatedAt    DateTime?
  artifact     Artifact @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("theme")
}

model Page {
  id                 String                  @id @default(cuid())
  artifactId         String
  name               String                  @default("")
  elements           Json?
  reactComponent     String?
  type               String                  @default("editor")
  createdAt          DateTime?
  updatedAt          DateTime?
  artifact           Artifact                @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  paths              PagePath[]
  dataSourceBindings PageDataSourceBinding[]

  @@index([artifactId])
  @@map("pages")
}

model PagePath {
  id        String   @id @default(cuid())
  artifactId String
  pageId    String
  path      String
  createdAt DateTime?
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([artifactId, path])
  @@index([pageId])
  @@map("paths")
}

model Section {
  id        String   @id @default(cuid())
  artifactId String
  name      String
  type      String
  content   String
  source    String   @default("json")
  createdBy String
  createdAt DateTime?
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@map("sections")
}

model Template {
  id         String   @id @default(cuid())
  name       String
  description String?
  imageUrl   String?
  previewUrl String?
  category   String?
  type       String   @default("section")
  status     String   @default("draft")
  usableOn   Json?
  content    Json?
  createdBy  String   @default("user")
  createdAt  DateTime?

  @@map("templates")
}

model DataSource {
  id        String                  @id @default(cuid())
  artifactId String
  name      String
  type      String
  methods   Json?
  url       String?
  headers   Json?
  connection String?
  data      Json?
  datalistId String?
  createdAt DateTime?
  artifact  Artifact                @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  bindings  PageDataSourceBinding[]

  @@index([artifactId])
  @@map("sources")
}

model PageDataSourceBinding {
  id         String     @id
  artifactId String
  pageId     String
  sourceId   String
  methodName String
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([artifactId, pageId])
  @@map("page_data_sources")
}

model Datalist {
  id        String   @id @default(cuid())
  artifactId String
  name      String
  data      String
  createdAt DateTime?
  updatedAt DateTime?
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@map("datalists")
}

model Redirect {
  id         String   @id @default(cuid())
  artifactId String
  from       String
  to         String
  type       String
  created_by String
  created_on DateTime?
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, created_on])
  @@map("redirects")
}

model EnvironmentVariable {
  id        String   @id @default(cuid())
  artifactId String
  name      String
  value     String
  dataType  String
  isPrivate Boolean  @default(false)
  createdBy String
  createdOn DateTime?
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, createdOn])
  @@map("environments")
}

model SiteStructure {
  id                  String   @id
  artifactId         String   @unique
  structure           Json?
  status              String
  themeChanged        Boolean  @default(false)
  redirectsChanged    Boolean  @default(false)
  assetsChanged       Boolean  @default(false)
  appBaseChanged      Boolean  @default(false)
  environmentsChanged Boolean  @default(false)
  updatedAt           DateTime?
  artifact            Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@map("structure")
}

model Deployment {
  id          String   @id @default(cuid())
  artifactId  String
  structure   Json?
  status      String
  theme       Json?
  redirects   Json?
  siteProfile Json?
  environments Json?
  attemptedOn DateTime?
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, status, attemptedOn])
  @@map("deployments")
}

model Server {
  id                       String       @id @default(cuid())
  name                     String
  publicIp                 String
  privateIp                String?
  privateKey               String?
  serverType               String?
  platform                 String?
  provider                 String?
  isPrivate                Boolean?
  username                 String?
  basePath                 String?
  appPath                  String?
  storageUsed              String?
  storageTotal             String?
  storageUnit              String?
  portsOpen                Json?
  serverConfigured         Boolean      @default(false)
  defaultNginxConfigStatus String?
  createdOn                DateTime?
  expiresOn                DateTime?
  allocations              Allocation[]
  logs                     ServerLog[]

  @@map("servers")
}

model Allocation {
  id               String   @id @default(cuid())
  serverId         String
  artifactId       String
  username         String?
  deploymentPath   String?
  storageAllocation String?
  port             Int?
  allocatedStorage Int?
  allocatedOn      DateTime?
  status           String   @default("active")
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  artifact         Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, serverId])
  @@map("allocations")
}

model ServerLog {
  id          String   @id @default(cuid())
  serverId    String
  commandId   String?
  commandName String?
  command     String
  output      String
  status      String
  initiatedBy String
  initiatedAt DateTime?
  completedAt DateTime?
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, initiatedAt])
  @@map("serverLogs")
}

model ServerCommand {
  id                String   @id @default(cuid())
  name              String
  description       String?
  commandTemplate   String
  parameters        Json?
  preExecutionScript String?
  allocatesPort     Boolean  @default(false)
  portToReserve     String?
  type              String   @default("view")
  danger            String   @default("low")
  nextCommands      Json?
  createdAt         DateTime?

  @@map("serverCommands")
}

model CodeFile {
  id        String   @id @default(cuid())
  artifactId String
  fileName  String
  filePath  String
  content   String
  size      Int      @default(0)
  createdAt DateTime?
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, createdAt])
  @@map("codeFiles")
}

model LinkedAccount {
  id               String   @id @default(cuid())
  account_id       String
  platform         String
  accessToken      String
  refreshToken     String?
  scope            String
  providerUserId   String
  providerUsername String
  authorized_on    DateTime?

  @@index([account_id, platform])
  @@unique([account_id, platform, providerUserId])
  @@map("linked_accounts")
}

model ApiToken {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  tokenHash   String
  tokenPrefix String
  createdAt   DateTime?
  lastUsed    DateTime?

  @@index([accountId, createdAt])
  @@map("api_tokens")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int?
  members     Member[]

  @@map("teams")
}

model Member {
  id          String   @id @default(cuid())
  name        String
  email       String
  role        String
  imageUrl    String?
  permissions Json?
  teams       Team[]

  @@map("members")
}

model JobPosting {
  id             String      @id @default(cuid())
  title          String
  location       String?
  type           String?
  description    String?
  status         String
  qualifications Json?
  salary         String?
  openings       Int?
  createdAt      DateTime?
  updatedAt      DateTime?
  applicants     Applicant[]

  @@map("hiring")
}

model Applicant {
  id          String     @id @default(cuid())
  jobId       String
  name        String
  email       String
  resumeUrl   String?
  coverLetter String?
  status      String
  appliedAt   DateTime?
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, appliedAt])
  @@map("applicants")
}

model ErrorLog {
  id             String   @id @default(cuid())
  message        String
  stack          String?
  componentStack String?
  source         String?
  details        String?
  timestamp      DateTime @default(now())

  @@index([timestamp])
  @@map("errors")
}

model AppBaseBackup {
  id         String   @id @default(cuid())
  artifactId String
  fileName   String
  fileType   String
  content    String
  backedUpAt DateTime?
  backedUpBy String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, backedUpAt])
  @@map("appBaseBackups")
}

model NewsArticle {
  id          String   @id
  slug        String?
  title       String
  content     String
  author      String
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?

  @@map("news")
}

model SyncRequest {
  id          String   @id @default(cuid())
  source      String
  destination String
  data        Json
  status      String   @default("pending")
  requestedOn DateTime @default(now())
  attemptOn   DateTime?

  @@map("sync_request")
}

model SyncerLog {
  id         String   @id @default(cuid())
  appId      String?  @map("app_id")
  clientId   String?  @map("client_id")
  type       String
  content    String
  createdOn  DateTime? @map("created_on")
  status     String?

  @@index([appId, clientId, type, createdOn])
  @@map("syncer_log")
}
