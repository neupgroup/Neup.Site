Table: projects, Model: Project
Fields:
> id: string, primary key;
> projectId: string, nullable, references projects.id;
> name: string, default: "";
> url: string, nullable;
> tier: string, default: "free";
> modules: jsonb, nullable;
> icons: jsonb, nullable;
> domains: jsonb, nullable;
> design: jsonb, nullable;
> features: jsonb, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;
> ownerAccountId: string, nullable, indexed;
> status: string, nullable;
> type: string, nullable;
.. referenced by accounts.lastProject;

Table: accounts, Model: Account
Fields:
> id: string, primary key;
> displayName: string, default: "";
> displayImage: string, default: "";
> neupId: string, nullable, unique;
> type: string, default: "individual";
> createdOn: timestamp, default: current timestamp;
> status: string, default: "active";
> moreDetails: jsonb, nullable;
> lastProject: string, nullable, references projects.id, indexed;
.. references roles;
.. references pages, paths, sections, datalists, sources, environments, redirects, codeFiles, allocations, structures, deployments, appBaseBackups, assetModules, teams, members, roles, profiles;

Table: role, Model: Role
Fields:
> id: string, primary key;
> assetId: string, references projects.id;
> portfolioId: string;
> accountId: string, references accounts.id;
> role: string;
> status: string, default: "active";

Table: members, Model: Member
Fields:
> id: string, primary key, auto generated;
> assetId: string, references projects.id;
> slug: string;
> name: string;
> email: string;
> role: string;
> status: string, default: "active"; values: active, paused, hidden;
> imageUrl: string, nullable;
> metaDescription: string, nullable;
> language: string, nullable;
> tags: jsonb, nullable;
> order: int, nullable;
> teamId: string, nullable, references teams.id;
> permissions: jsonb, nullable;

Table: hiring, Model: JobPosting
Fields:
> id: string, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> slug: string;
> title: string;
> location: string, nullable;
> type: string, nullable;
> description: string, nullable;
> status: string;
> qualifications: jsonb, nullable;
> salary: string, nullable;
> openings: int, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;
.. references applicants;

Table: applicants, Model: Applicant
Fields:
> id: string, primary key, auto generated;
> jobId: string, references hiring.id, indexed;
> name: string;
> email: string;
> resumeUrl: string, nullable;
> coverLetter: string, nullable;
> status: string;
> appliedAt: timestamp, nullable;

Table: news, Model: News
Fields:
> id: string, primary key;
> projectId: string, nullable, references projects.id;
> slug: string, nullable;
> title: string;
> content: string;
> author: string;
> imageUrl: string, nullable;
> metaDescription: string, nullable;
> language: string, nullable;
> tags: jsonb, nullable;
> publishedAt: timestamp, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;

Table: articles, Model: Article
Fields:
> id: string, primary key;
> projectId: string, nullable, references projects.id;
> slug: string, nullable;
> title: string;
> content: string;
> author: string;
> imageUrl: string, nullable;
> metaDescription: string, nullable;
> language: string, nullable;
> tags: jsonb, nullable;
> publishedAt: timestamp, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;
.. references projects;

Table: forms, Model: Form
Fields:
> id: string, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> name: string;
> slug: string;
> fields: jsonb;
> createdOn: timestamp, default current timestamp;
.. references formSubmissions;

Table: formSubmissions, Model: FormSubmission
Fields:
> id: string, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> formId: string, references forms.id, indexed;
> response: jsonb;
> postedOn: timestamp, default current timestamp;
> status: varchar(16);

Table: reviews, Model: Review
Fields:
> id: string, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> reviewer: string;
> content: string, nullable;
> rating: int;
> createdOn: timestamp, default: current timestamp;
> reply: string, nullable;
> repliedOn: timestamp, nullable;

Table: block_templates, Model: BlockTemplate
Fields:
> id: uuid, primary key, auto generated;
> name: string;
> slug: varchar(24);
> media: jsonb, nullable;
> type: string, default: "page"; values: page, section, element;
> description: string, nullable;
> version: string, nullable;
> payload: jsonb, nullable;
> code: text, nullable;
> compatibility: jsonb, nullable;
> createdOn: timestamp, default current timestamp;
> lastUpdated: timestamp, auto updated;
.. references blocks;

Table: blocks, Model: Block
Fields:
> id: uuid, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> name: string;
> slug: string;
> templateId: uuid, nullable, references block_templates.id, indexed;
> payload: jsonb, nullable;
> lastUpdated: timestamp, auto updated;
