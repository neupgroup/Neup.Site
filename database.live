Table: projects, Model: Asset
Fields:
> id: string, primary key;
> name: string, default: "";
> url: string, nullable;
> tier: string, default: "free";
> modules: jsonb, nullable;
> icons: jsonb, nullable;
> domains: jsonb, nullable;
> design: jsonb, nullable;
> features: jsonb, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;
> ownerAccountId: string, nullable, indexed;
> status: string, nullable;
> type: string, nullable;
.. referenced by accounts.defaultProject;

Table: accounts, Model: Account
Fields:
> id: string, primary key;
> displayName: string, default: "";
> displayImage: string, default: "";
> neupId: string, nullable, unique;
> type: string, default: "individual";
> createdOn: timestamp, default: current timestamp;
> status: string, default: "active";
> moreDetails: jsonb, nullable;
> defaultProject: string, nullable, references projects.id, indexed;
.. references roles;
.. references pages, paths, sections, datalists, sources, environments, redirects, codeFiles, allocations, structures, deployments, appBaseBackups, assetModules, teams, members, roles, profiles;

Table: role, Model: Role
Fields:
> id: string, primary key;
> assetId: string, references projects.id;
> portfolioId: string;
> accountId: string, references accounts.id;
> role: string;
> status: string, default: "active";

Table: members, Model: Member
Fields:
> id: string, primary key, auto generated;
> assetId: string, references projects.id;
> slug: string;
> name: string;
> email: string;
> role: string;
> status: string, default: "active"; values: active, paused, hidden;
> imageUrl: string, nullable;
> order: int, nullable;
> teamId: string, nullable, references teams.id;
> permissions: jsonb, nullable;

Table: hiring, Model: JobPosting
Fields:
> id: string, primary key, auto generated;
> projectId: string, references projects.id, indexed;
> slug: string;
> title: string;
> location: string, nullable;
> type: string, nullable;
> description: string, nullable;
> status: string;
> qualifications: jsonb, nullable;
> salary: string, nullable;
> openings: int, nullable;
> createdAt: timestamp, nullable;
> updatedAt: timestamp, nullable;
.. references applicants;

Table: applicants, Model: Applicant
Fields:
> id: string, primary key, auto generated;
> jobId: string, references hiring.id, indexed;
> name: string;
> email: string;
> resumeUrl: string, nullable;
> coverLetter: string, nullable;
> status: string;
> appliedAt: timestamp, nullable;
