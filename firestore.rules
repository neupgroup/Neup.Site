/**
 * @fileOverview Firestore Security Rules for Neup.Sites.
 *
 * Core Philosophy:
 * This ruleset prioritizes security and scalability using path-based authorization. It enforces a strict parent-child relationship between sites and pages.
 *
 * Data Structure:
 * - /sites/{siteId}: Contains site metadata.
 * - /sites/{siteId}/pages/{pageId}: Contains page content associated with a specific site.
 *
 * Key Security Decisions:
 * - Access to sites and pages is restricted based on their parent-child relationship.
 * - Pages are secured using path-based ownership tied to the site ID.
 * - No external data lookups (`get()` calls) are used for authorization, ensuring efficient and scalable rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to site documents.
     * @path /sites/{siteId}
     * @allow get, list: if true;
     * @allow create: if request.resource.data.id == request.auth.uid;
     * @allow update, delete: if isExistingOwner(siteId);
     * @deny create: if request.resource.data.id != request.auth.uid;
     * @deny update, delete: if !isExistingOwner(siteId);
     * @principle Enforces document ownership for writes and allows public reads.
     */
    match /sites/{siteId} {
      allow get, list: if true;
      allow create: if request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(siteId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(siteId);

      /**
       * @description Controls access to page documents within a site.
       * @path /sites/{siteId}/pages/{pageId}
       * @allow get, list: if true;
       * @allow create: if request.resource.data.siteId == siteId;
       * @allow update, delete: if isExistingOwner(siteId);
       * @deny create: if request.resource.data.siteId != siteId;
       * @deny update, delete: if !isExistingOwner(siteId);
       * @principle Enforces a parent-child relationship between sites and pages for authorization.
       */
      match /pages/{pageId} {
        allow get, list: if true;
        allow create: if request.resource.data.siteId == siteId;
        allow update: if isExistingOwner(siteId) && request.resource.data.siteId == resource.data.siteId;
        allow delete: if isExistingOwner(siteId);
      }
    }
    
    match /servers/{serverId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false; // To-Do: Define admin roles
    }

    /**
     * @description Fallback rule: deny all access to any other path.
     * @path /databases/{database}/documents/{any}/{any}
     * @allow get, list, create, update, delete: if false;
     * @principle Provides a default deny-all policy for any unhandled paths.
     */
    match /{path=**} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(siteId) {
      return isSignedIn() && isOwner(siteId) && resource != null;
    }
  }
}