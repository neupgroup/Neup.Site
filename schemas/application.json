{
  "identity": {
    "name": "Application Name",
    "@comment:name": "This is the name of the applicationn to be used for identification",
    "description": "Application's main description for the Search Engines",
    "@comment:name": "Pass the description for the application, this is only for the application owner to use.",
    "version": "1.0.0.02",
    "@comment:version": "This is the version of the application that has been published, this is primarily used for the neup system to make an updates and so more. This follows the usual versioning system, with 1.0.0 and then final counter is for the number of updates pushed with a prefix 0 to it."
  },
  "design": {
    "color": {
      "primary": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617",
        "1000": "#000000"
      },
      "secondary": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617",
        "1000": "#000000"
      }
      "@comment": "Add upto 3 colors, keys are: primary, secondary, and tertiary. \n Minimum number of colors allowed is 1. \n If no colors are added, black color and its tints will be selected for the entire application.",
    },
    "spacing": {
      "small": "4px",
      "medium": "8px",
      "large": "16px",
      "extraLarge": "32px"
    },
    "cornering": {
      "small": "4px",
      "medium": "8px",
      "large": "16px",
      "extraLarge": "32px"
    },
    "elements": {
      "theme.dark" : {
        "seperator": "#colors.primary.500",
        "button": {"background": "#colors.primary.500", "text": "#colors.primary.50"}        
      },
      "theme.light" : {
        "seperator": "#colors.primary.500",
        "button": {"background": "#colors.primary.500", "text": "#colors.primary.50"}        
      },
      "theme.black": {
        "seperator": "#colors.primary.500",
        "button": {"background": "#colors.primary.500", "text": "#colors.primary.50"}        
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "Arial, sans-serif",
        "secondary": "Helvetica, sans-serif"
      },
      "customStyles": {
        "h1": {
          "fontSize": "2rem",
          "fontWeight": "bold",
          "file": "@/base/fonts/CustomFont.ttf"
        },
        "h2": {
          "fontSize": "1.5rem",
          "fontWeight": "bold",
          "file": "@/base/fonts/CustomFont.ttf"
        },
        "body": {
          "fontSize": "1rem",
          "fontWeight": "normal",
          "file": "@/base/fonts/CustomFont.ttf"
        }
      }
    }
  },
  "features": {
    "database": {
      "isRequired": true,
      "type": "postgresql"
    },
    "fileStorage": {
      "isRequired": false,
      "type": "local"
    },
    "notifications": {
      "isRequired": false,
      "type": "push"
    }
  },
  "account": {
    "isRequired": true,
    "accountSystem": "neupId/emailpass/userpass"
  },
  "logica": {
    "requiredModules": [
      "account",
      "estate"
    ]
  },
  "permissions": [
    "location",
    "camera",
    "microphone"
  ],
  "storage": {
    "type" : "local/remote.static/neup.drive",
    "driveRelocation": {
      "from": "https://neupcdn.com/driveid",
      "@comment:from": "This is the link that is base URL generated by the application", 
      "to": "https://domainname.com/assets",
      "@comment:to": "This will define how to change the links's basepath to a new domain standard baselink, and can be helpful for when, you want to render the images as being shown in your own domain instead of from the cdn itself."
    }
  },
  "platforms": {
    "web": {
      "exists": true,
      "location": "https://domainname.com"
    },
    "android": {
      "exists": true,
      "packageName": "com.domainname.app"
    },
    "ios": {
      "exists": true,
      "bundleIdentifier": "com.domainname.app"
    }
  },
  "assets": {
    "logo": {
      "main": "/assets/logo.png",
      "48x48": "/assets/android/icon-48.png",
      "72x72": "/assets/android/icon-72.png",
      "96x96": "/assets/android/icon-96.png",
      "144x144": "/assets/android/icon-144.png",
      "256x256": "/assets/android/icon-256.png",
      "512x512": "/assets/android/icon-512.png",
      "1024x1024": "/assets/android/icon-1024.png",
      "background": "/assets/android/background.png",
      "adaptive": {
        "foreground": "/assets/android/adaptive-foreground.png",
        "background": "/assets/android/adaptive-background.png"
      },
      "altText": "Application Logo"
    },
    "favicon": {
      "path": "/assets/favicon.ico",
      "altText": "Application Favicon"
    },
    "splashScreen": {
      "path": "/assets/splash.png",
      "altText": "Application Splash Screen"
    }
  }
}
